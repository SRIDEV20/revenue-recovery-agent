# Base URL of the backend API, including the /api prefix (all backend routes
# are mounted under /api - see backend/main.py).
#
# Local dev: leave unset (falls back to "/api", proxied to localhost:8000 by
# vite.config.js's dev server proxy) or set it explicitly, e.g.:
VITE_API_BASE_URL=http://localhost:8000/api

# Production (Vercel): set this to your deployed Render backend URL + /api, e.g.
# VITE_API_BASE_URL=https://revenue-recovery-api.onrender.com/api
